# Credencials OAuth (Google Cloud Console > APIs i serveis > Credencials)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
REDIRECT_URI=http://localhost:5000/callback

# Clau per a les sessions de Flask (qualsevol cadena llarga i aleatòria)
SECRET_KEY=canvia-aixo-per-una-cadena-aleatoria

# Clau per xifrar els tokens a la base de dades. Genera-la amb:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_KEY=

# Només en desenvolupament local (http en lloc de https). Treure-ho en producció!
OAUTHLIB_INSECURE_TRANSPORT=1
